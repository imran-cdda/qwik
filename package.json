{
  "name": "@qwik/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "exports": {
    "./engine": "./packages/engine/index.tsx",
    "./engine/*": "./packages/engine/*",
    "./erm": "./packages/erm/index.ts",
    "./erm/financial": "./packages/erm/financial/index.ts",
    "./erm/financial/components": "./packages/erm/financial/components.tsx",
    "./erm/financial/*": "./packages/erm/financial/*",
    "./erm/hr": "./packages/erm/hr/index.ts",
    "./erm/hr/components": "./packages/erm/hr/components.tsx",
    "./erm/hr/*": "./packages/erm/hr/*",
    "./erm/inventory": "./packages/erm/inventory/index.ts",
    "./erm/inventory/components": "./packages/erm/inventory/components.tsx",
    "./erm/inventory/*": "./packages/erm/inventory/*",
    "./crm": "./packages/crm/index.ts",
    "./crm/actions": "./packages/crm/actions.ts",
    "./crm/components": "./packages/crm/components.tsx",
    "./crm/*": "./packages/crm/*",
    "./shared": "./packages/shared/index.ts",
    "./shared/*": "./packages/shared/*"
  },
  "scripts": {
    "dev": "bun --cwd apps/next dev",
    "dev:astro": "APP_BASE_URL=http://localhost:4321 bun --cwd apps/astro dev",
    "dev:all": "concurrently \"bun --cwd apps/next dev\" \"bun --cwd apps/astro dev\"",
    "build": "bun --cwd apps/next build",
    "build:astro": "bun --cwd apps/astro build",
    "build:all": "bun build && bun build:astro",
    "start": "bun --cwd apps/next start",
    "start:astro": "APP_BASE_URL=http://localhost:4321 bun --cwd apps/astro start",
    "start:all": "concurrently \"bun --cwd apps/next start\" \"bun --cwd apps/astro start\"",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "bun@1.3.14"
}
